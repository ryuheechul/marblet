{
  "name": "marblet",
  "version": "2.0.0",
  "description": "A helper tool for marble testing with RxJS",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": "https://github.com/ryuheechul/marblet",
  "author": "Heechul Ryu",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "files": [
    "dist",
    "tests"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "rxjs",
    "rxjs6",
    "rxjs7",
    "testing",
    "marble-testing"
  ],
  "peerDependencies": {
    "rxjs": "^6.6.7 || ^7.0.0"
  },
  "devDependencies": {
    "marblet": "workspace:*",
    "rxjs": "^7.8.2",
    "semantic-release": "latest",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}
